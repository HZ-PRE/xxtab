[Interface]
PrivateKey = REPLACE_WITH_CLIENT_PRIVATE_KEY
Address = 10.66.66.2/32
DNS = 1.1.1.1
# Optional fixed source port. Otherwise a free port is selected at startup.
ListenPort = 51822

[Peer]
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
AllowedIPs = 0.0.0.0/0, ::/0
# Original Endpoint is ignored; xxtab inserts its loopback listener.
Endpoint = 127.0.0.1:51820
