# Include inside nginx's http {} context, e.g. a sites-enabled file.
# Replace vpn.example.com, certificate paths, and CHANGE_ME_LONG_RANDOM_SECRET.
# Cloudflare SSL/TLS mode: Full (strict). Backend wstunnel listens on loopback only.
map $http_upgrade $xxtab_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name vpn.example.com;
    ssl_certificate /etc/letsencrypt/live/vpn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vpn.example.com/privkey.pem;
    tcp_nodelay on;

    # The path is an authentication secret. Do not record it in access logs.
    access_log off;
    location = /CHANGE_ME_LONG_RANDOM_SECRET/events {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $xxtab_connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_socket_keepalive on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location / { return 404; }
}

# Matching backend command:
# wstunnel server --restrict-to 127.0.0.1:7007 \
#   --restrict-http-upgrade-path-prefix CHANGE_ME_LONG_RANDOM_SECRET \
#   --websocket-ping-frequency 15s ws://127.0.0.1:8080
